# jasnauskaite.lt — saugumo header'iai + higiena (2026-08-04)
# Deploy'inamas iš git repo šaknies į public_html.

RewriteEngine On

# www -> apex (kanoninis)
RewriteCond %{HTTP_HOST} ^www\.jasnauskaite\.lt$ [NC]
RewriteRule ^ https://jasnauskaite.lt%{REQUEST_URI} [R=301,L]

# http -> https (dubliuoja Hostinger Force HTTPS, jei toks ijungtas)
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Vidiniai dev artefaktai viesai neegzistuoja
RedirectMatch 404 ^/mockups(/.*)?$
RedirectMatch 404 ^/php-analytics(/.*)?$

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # SVARBU: ne X-Frame-Options SAMEORIGIN — reelize.lt iframe'ina /phone-embed.html.
  # frame-ancestors leidzia tik self + reelize.lt; upgrade-insecure-requests islaikytas.
  Header always set Content-Security-Policy "upgrade-insecure-requests; frame-ancestors 'self' https://reelize.lt https://www.reelize.lt"
</IfModule>
